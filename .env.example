# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=noreply@tutordigital.es

# Sentry (error tracking)
# Backend: set on Render as environment variable
SENTRY_DSN=
# Frontend: set SENTRY_DSN value in assets/shared/config/runtime-config.js before deploy

# Server
PORT=10000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
