# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Backup manual de la base de datos (scripts/backup-db.sh — plan Free no
# incluye backups). Dashboard de Supabase -> Connect -> pestaña "Session
# pooler" (puerto 5432, funciona con IPv4 en plan Free).
SUPABASE_DB_URL=postgresql://postgres.<project>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Opcional — por defecto ~/tutordigital-backups (fuera del repo)
BACKUP_DEST_DIR=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# tutordigital-pdf-service (informes/recibos en PDF)
# Local: http://localhost:3002 — Producción (Render): https://tutordigital-pdf-service.onrender.com
PDF_SERVICE_URL=http://localhost:3002

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=noreply@tutordigital.es

# Sentry (error tracking)
# Backend: set on Render as environment variable
SENTRY_DSN=
# Frontend: set SENTRY_DSN value in assets/shared/config/runtime-config.js before deploy

# Peppers de hashing — invitaciones de alumno / join codes (secretos, generar uno propio por entorno)
INVITE_CODE_PEPPER=
JOIN_CODE_PEPPER=

# Server
PORT=10000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CHAT_ALLOWED_ORIGINS=
APP_BASE_URL=https://tutordigital.app

# Límites de tamaño / timeout por ruta
CHAT_BODY_LIMIT_BYTES=250000
CHAT_HANDLER_TIMEOUT_MS=30000
TICKETS_BODY_LIMIT_BYTES=250000

# Rate limit por ruta (requests / ventana en ms)
CHAT_RATE_MAX=
CHAT_RATE_WINDOW_MS=
TICKETS_RATE_MAX=
TICKETS_RATE_WINDOW_MS=
ADMIN_GROUPS_RATE_MAX=
ADMIN_GROUPS_RATE_WINDOW_MS=
ADMIN_STUDENTS_RATE_MAX=
ADMIN_STUDENTS_RATE_WINDOW_MS=
ADMIN_TEACHERS_RATE_MAX=
ADMIN_TEACHERS_RATE_WINDOW_MS=
STUDENT_REGISTER_RATE_MAX=
STUDENT_REGISTER_RATE_WINDOW_MS=
TEACHER_REDEEM_RATE_MAX=
TEACHER_REDEEM_RATE_WINDOW_MS=
